# Gmail Configuration for Contact Form
# You need to create an App Password in your Gmail account
# Go to: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Example:
# GMAIL_USER=ykp.supplies@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Google Analytics Configuration
# Get your GA4 Measurement ID from Google Analytics
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Dashboard Protection
# Set a strong password for production use
ADMIN_PASSWORD=your-strong-admin-password

# Google Analytics API Configuration (Optional - for real data)
# Create a service account in Google Cloud Console
# GA_PROPERTY_ID=123456789
# GA_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"